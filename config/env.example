# pr-review-routine の設定の例。同じディレクトリの config/env に写して使う（config/env は .gitignore で除外している）。
#   cp config/env.example config/env
#   chmod 600 config/env
# 書式は KEY=VALUE。# で始まる行はコメント（値の後ろにコメントは書けない）
# パスは ~ から書くか、config/ からの相対パスで書く

# 対象の GitHub organization（必須）
PR_REVIEW_ORG=your-org

# レビュー観点のファイル（任意）。「:」区切りで複数指定できる。毎回コピーして Claude に渡す
# PR_REVIEW_RULE_FILES=~/notes/review/general.md:~/notes/review/team.md

# レビューの指示に付け足す、自分用の指示（任意）。
# 観点ファイルのどれを優先するか、変更の種類ごとにどの観点を当てるか、などを書く。
# config/ に置くなら review_extra.md のように書く（config/ の中は env.example 以外 .gitignore で除外している）
# PR_REVIEW_EXTRA_PROMPT=review_extra.md

# 自動で動く曜日（1 = 月曜 〜 7 = 日曜。終わりを含む）と時間帯（Mac のタイムゾーン。9-20 なら 9:00〜19:59）
# PR_REVIEW_DAYS=1-5
# PR_REVIEW_HOURS=9-20

# 1 回でレビューする最大件数
# PR_REVIEW_MAX_PER_RUN=5

# これを超える行数の差分は、要約と注意点を中心にする
# PR_REVIEW_LARGE_DIFF_LINES=3000

# 1 件のレビューの制限時間（秒）
# PR_REVIEW_TIMEOUT_SEC=1200

# モデルと effort（省略時は claude の既定）
# PR_REVIEW_MODEL=
# PR_REVIEW_EFFORT=

# 質問用サーバーのポート
# PR_REVIEW_PORT=8765
